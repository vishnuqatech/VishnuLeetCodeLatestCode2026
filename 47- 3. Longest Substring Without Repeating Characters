class Solution {
    public int lengthOfLongestSubstring(String s) {
    
int freq[] = new int[256];

int S = 0, maxLen = 0;

for (int i = 0; i < s.length(); i++) {

    freq[s.charAt(i)]++;

    while (freq[s.charAt(i)] > 1) {
        freq[s.charAt(S)]--;
        S++;
    }

    maxLen = Math.max(maxLen, i - S + 1);
}
return maxLen;

    }   
}
