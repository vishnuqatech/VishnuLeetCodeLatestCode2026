class Solution {
    public int[] intersection(int[] nums1, int[] nums2) {
        Arrays.sort(nums1);
        Arrays.sort(nums2);
        int i=0,j=0;
        Set <Integer> result=new HashSet <Integer> ();
        while(i<nums1.length && j<nums2.length){
            if(nums1[i]==nums2[j]){
                result.add(nums1[i]);
                j++;
                i++;
            }else if (nums1[i] < nums2[j]){
                i++;

            }else{
                j++;
            }
        }

     int [] res=new int[result.size()]  ;     
     int index=0;
     for(int num:result){
      res[index++]=num;
    }
   return res;   
    }
}
